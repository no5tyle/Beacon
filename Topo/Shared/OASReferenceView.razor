@inherits Controller.OASReferenceController
@using Topo.Controller
@using Topo.Model.Insights
@using Topo.Model.OAS

@if (AppMode)
{
    <PageTitle>Topo Reference</PageTitle>

    <div class="app-top">
        <header class="app-bar">
            <span class="app-title">Topo Reference</span>
            <button type="button" class="btn app-menu-button" aria-label="Filters" aria-expanded="@(filtersOpen ? "true" : "false")" @onclick="() => filtersOpen = !filtersOpen">
                <span class="navbar-toggler-icon"></span>
                @if (ActiveFilterCount > 0)
                {
                    <span class="badge rounded-pill bg-warning text-dark app-filter-count">@ActiveFilterCount</span>
                }
            </button>
        </header>
        @if (filtersOpen)
        {
            <div class="app-filters">
                @FilterControls
                <div class="d-flex justify-content-between mt-3">
                    <button type="button" class="btn btn-link btn-sm px-0" @onclick="ClearFilters">Clear filters</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => filtersOpen = false">Done</button>
                </div>
            </div>
        }
    </div>
    <div class="app-search">
        <input type="search" class="form-control" placeholder="Search statements and explanations" aria-label="Search" @bind="search" @bind:event="oninput" />
    </div>
    <div class="app-content">
        @Results_
    </div>
}
else
{
    <PageTitle>Topo / OAS reference</PageTitle>

    <div class="mt-3 mb-3">
        <h2>OAS reference</h2>
        <p class="text-muted mb-0">
            Every Outdoor Adventure Skills I statement, with the fuller explanation Terrain gives. Click a statement to expand it.
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="OpenApp">Open as the Topo Reference app</button> to add it to your phone's home screen.
        </p>
    </div>

    @FilterControls
    <div class="row g-2 mb-3 mt-0 align-items-end">
        <div class="col-sm-8">
            <label class="form-label small" for="search">Search</label>
            <input id="search" type="search" class="form-control" placeholder="Words in the statement or its explanation, e.g. compass" @bind="search" @bind:event="oninput" />
        </div>
        <div class="col-sm-4 text-sm-end">
            <button type="button" class="btn btn-link btn-sm" @onclick="ClearFilters">Clear filters</button>
        </div>
    </div>

    @Results_
}

@code {
    private RenderFragment FilterControls => __builder =>
    {
    <div class="row g-2 mb-2 align-items-end">
        <div class="col-sm-3">
            <label class="form-label small" for="stream">Stream</label>
            <select id="stream" class="form-select" value="@streamChoice" @onchange="StreamChange">
                <option value="@OASReferenceController.CoreStreams">Core streams</option>
                <option value="@OASReferenceController.AllStreams">All streams</option>
                @foreach (var stream in InsightsCalculator.Streams)
                {
                    <option value="@stream.Key">@stream.Display</option>
                }
            </select>
        </div>
        <div class="col-sm-4">
            <label class="form-label small" for="theme">Skill theme</label>
            <select id="theme" class="form-select" @bind="theme">
                <option value="">All themes</option>
                @foreach (var t in Themes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-2">
            <label class="form-label small" for="part">Part</label>
            <select id="part" class="form-select" @bind="part">
                <option value="">All parts</option>
                @foreach (var p in OASReference.Parts)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>
        <div class="col-6 col-sm-3">
            <label class="form-label small" for="where">Where</label>
            <select id="where" class="form-select" @bind="where">
                <option value="@OASReferenceWhere.Any">Anywhere</option>
                <option value="@OASReferenceWhere.UnitNight">Unit night</option>
                <option value="@OASReferenceWhere.Outing">Needs an outing</option>
            </select>
        </div>
    </div>
    <div class="mb-2">
        <span class="form-label small d-block mb-1">Stages <span class="text-muted">(none selected shows every stage)</span></span>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var number in StageNumbers)
            {
                var on = stages.Contains(number);
                <button type="button" class="btn btn-sm @(on ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleStage(number)">Stage @number</button>
            }
        </div>
    </div>
    };

    private RenderFragment Results_ => __builder =>
    {
        <div>
        @if (!string.IsNullOrEmpty(loadingMessage))
        {
            <p class="text-muted">@loadingMessage...</p>
        }

        @{
            var results = Results;
            var shown = results.Take(OASReferenceController.DisplayLimit).ToList();
        }

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mb-2">
            <span class="small text-muted">
                @results.Count statement@(results.Count == 1 ? "" : "s")@(results.Count > shown.Count ? $", showing the first {shown.Count}. Narrow the filters to see the rest." : "")
            </span>
            @if (shown.Any())
            {
                <span>
                    <button type="button" class="btn btn-link btn-sm p-0 me-2" @onclick="() => ExpandAll(shown, true)">Expand all</button>
                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ExpandAll(shown, false)">Collapse all</button>
                </span>
            }
        </div>

        @foreach (var stageGroup in shown.GroupBy(s => s.Stage.TemplateLink))
        {
            var stageInfo = stageGroup.First().Stage;
            <div class="card mb-3 stage-group @(AppMode ? "as-cards" : "")">
                <div class="card-header"><strong>@stageInfo.Title</strong></div>
                <ul class="list-group list-group-flush">
                    @foreach (var statement in stageGroup)
                    {
                        var open = expanded.Contains(statement.Key);
                        <li class="list-group-item statement @(open ? "open" : "")" @onclick="() => Toggle(statement)">
                            <div class="d-flex flex-column @(AppMode ? "" : "flex-sm-row") justify-content-between align-items-start gap-1 @(AppMode ? "" : "gap-sm-2")">
                                <span>
                                    <span class="badge bg-light text-dark border me-1">@statement.Part</span>
                                    @statement.Label
                                </span>
                                <span class="@(AppMode ? "" : "text-sm-nowrap")">
                                    <span class="badge bg-info text-dark">@statement.Theme</span>
                                    <span class="badge @(statement.UnitNightSuitable ? "bg-success" : "bg-secondary")">@(statement.UnitNightSuitable ? "unit night" : "outing")</span>
                                    <span class="text-muted small ms-1">@(open ? "▴" : "▾")</span>
                                </span>
                            </div>
                            @if (open)
                            {
                                <div class="statement-detail">
                                    @if (string.IsNullOrEmpty(statement.Detail))
                                    {
                                        <em class="text-muted">Terrain has no further explanation for this statement.</em>
                                    }
                                    else
                                    {
                                        <em>@statement.Detail</em>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!results.Any() && string.IsNullOrEmpty(loadingMessage))
        {
            <p class="text-muted">No statements match these filters.</p>
        }
        </div>
    };
}
