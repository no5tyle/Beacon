@page "/awards"
@inherits Controller.AdditionalAwardsController

<PageTitle>Beacon / Awards</PageTitle>

<EditForm Model="@model">

    <div class="mt-3 mb-3 row">
        <h2>Additional Awards @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    @if (model.Members != null && model.Members.Any())
    {
        <div class="mb-2">
            <input type="checkbox" id="checkall" class="form-check-input" @onchange="SelectAllChange" /><label for="checkall" class="form-check-label">&nbsp;Select All</label>
        </div>

        <div class="stack-list">
            <div class="row header">
                <div class="col-sm">
                    <strong>Select</strong>
                </div>
                <div class="col-sm">
                    <strong>First Name</strong>
                </div>
                <div class="col-sm">
                    <strong>Last Name</strong>
                </div>
                <div class="col-sm">
                    <strong>Member Number</strong>
                </div>
                <div class="col-sm">
                    <strong>Patrol</strong>
                </div>
                <div class="col-sm">
                    <strong>Role</strong>
                </div>
                <div class="col-sm">
                    <strong>Unit Council</strong>
                </div>
            </div>

            @foreach (var item in model?.Members)
            {
                <div class="row striped">
                    <div class="col-auto col-sm">
                        <InputCheckbox id="@($"select-{item.id}")" class="form-check-input" @bind-Value="item.selected"></InputCheckbox>
                    </div>
                    <label class="col d-sm-none stack-title" for="@($"select-{item.id}")">@item.first_name @item.last_name</label>
                    <div class="col-sm d-none d-sm-block">
                        @item.first_name
                    </div>
                    <div class="col-sm d-none d-sm-block">
                        @item.last_name
                    </div>
                    <div class="col-sm" data-label="Member Number">@item.member_number</div>
                    <div class="col-sm" data-label="Patrol">@item.patrol_name</div>
                    <div class="col-sm" data-label="Role">@item.patrol_duty</div>
                    <div class="col-sm align-content-center" data-label="Unit Council">@(item.unit_council ? "Yes" : "")</div>
                </div>
            }
        </div>

        <div class="mt-3 mb-3 row">
            <div class="col-sm button-row">
                <button type="submit" name="button" @onclick="AwardsReportPdfClick" class="btn btn-primary">Awards Report (pdf)</button>
                <button type="submit" name="button" @onclick="AwardsReportXlsxClick" class="btn btn-success">Awards Report (xlsx)</button>
            </div>
        </div>
    }

</EditForm>
