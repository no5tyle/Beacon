@page "/"
@page "/Index"
@inherits Controller.IndexController

<PageTitle>Beacon / Home</PageTitle>
<EditForm Model="@indexPageViewModel">
    @if (indexPageViewModel.IsAuthenticated)
    {
        <div class="mt-3">
            <InstallHint />
        </div>
        <div class="mt-3 mb-3 row">
            <h2>Welcome @indexPageViewModel.FullName</h2>
        </div>
        <div class="mb-3 row">
            <label for="group" class="col-sm-2 col-form-label">
                Select Group to access:
            </label>
            <div class="col-sm-3">
                <select id="group" class="form-select" value="@indexPageViewModel.GroupId" @onchange="GroupChange">
                    <option value="">Select group</option>
                    @foreach (var group in indexPageViewModel.Groups)
                    {
                        <option value="@group.Key">@group.Value</option>
                    }
                </select>
                <label class="col-form-label validation-message">@indexPageViewModel.GroupErrorMessage</label>
            </div>
        </div>
        @if (Units.Count > 1)
        {
            <div class="mb-3 row">
                <label for="chosenUnit" class="col-sm-2 col-form-label">
                    Unit:
                </label>
                <div class="col-sm-3">
                    <select id="chosenUnit" class="form-select" value="@UnitId" @onchange="UnitChange">
                        <option value="">Select unit</option>
                        @foreach (var unit in Units)
                        {
                            <option value="@unit.Key">@unit.Value</option>
                        }
                    </select>
                    @if (string.IsNullOrEmpty(UnitId))
                    {
                        <label class="col-form-label validation-message">Choose the unit to work with. Every page uses it.</label>
                    }
                </div>
            </div>
        }
        <div class="mb-3 row">
            <p>
                Use Insights to see the unit's OAS gaps, who is moving up soon and what to programme next.
            </p>
            <p>
                Use Record OAS to tick off the same OAS statements for several youth at once, e.g. at the end of a unit night.
            </p>
            <p>
                Use Personal Progress to see where each youth is up to, record their OAS statements and submit stages for review.
            </p>
            <p>
                Use Reference to look up any OAS statement and its explanation.
            </p>
            <p>
                See <a href="approvals/approvals">Approvals</a> (under More) for what is waiting on the Unit Council.
            </p>
            <p class="small text-muted">
                Printable reports such as the wallchart, patrol lists and sign in sheets are in the desktop
                <a href="https://nomisnostab.github.io/Topo-Blazor/" target="_blank">Topo</a> app.
                Having a problem? <a href="logging">Turn on logging</a> to help track it down.
            </p>
        </div>
    }
</EditForm>


