@page "/progress/record-oas/{MemberId}"
@inherits Controller.RecordOASController
@using Topo.Model.OAS

<PageTitle>Beacon / Record OAS</PageTitle>

<div class="mt-3 mb-3">
    <h2>Record OAS for @member.first_name @member.last_name</h2>
    <p class="text-muted mb-0">
        Tick the "I" statements this youth has done and save them to Terrain on their behalf, then submit the stage for review.
        The Unit Council still approves it in Terrain.
    </p>
</div>

<div class="row g-3 mb-3 align-items-end">
    <div class="col-sm-5">
        <label for="stage" class="form-label">Stage</label>
        <select id="stage" class="form-select" value="@selectedTemplateLink" @onchange="StageChange" disabled="@working">
            <option value="">@(loadingStages ? "Loading stages..." : "Select a stage")</option>
            @foreach (var option in StageOptions())
            {
                <option value="@option.TemplateLink">@option.SelectListItemText</option>
            }
        </select>
    </div>
    <div class="col-sm-4">
        <input id="nonCore" type="checkbox" class="form-check-input" @bind="showNonCoreOAS" />
        <label class="form-check-label" for="nonCore">Include non-core OAS</label>
    </div>
    <div class="col-sm-3 text-sm-end">
        <a href="progress/details/@MemberId" class="btn btn-outline-secondary">Back to progress</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")">@message</div>
}

@if (loading)
{
    <p class="text-muted">Loading the stage from Terrain...</p>
}
else if (state != null)
{
    var done = state.Statements.Count(s => s.AlreadyDone);
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@StageTitle</strong>
            <span class="badge bg-secondary">@StatusDisplay(state.Status)</span>
        </div>
        <div class="card-body">
            <div class="mb-2 small text-muted">@done of @state.Statements.Count done in Terrain</div>

            @if (!CanEdit)
            {
                <div class="alert alert-info small">This stage is @StatusDisplay(state.Status).ToLower(), so it can't be changed here.</div>
            }
            else
            {
                @if (!CanVerifyStatements)
                {
                    <div class="alert alert-warning small">Adult leaders can't verify Stage @(OASRecording.MaxLeaderVerifiableStage + 1) and above. Statements need to be verified in Terrain by a suitable verifier.</div>
                }
                @if (!OASRecording.IsPreviousStageComplete(state.Stage.Stage, state.CompletedStagesInStream))
                {
                    <div class="alert alert-warning small">Stage @(state.Stage.Stage - 1) of this stream isn't complete in Terrain yet.</div>
                }
                @if (!OASRecording.CanReceiveCredit(state.Stage.Stage, state.CompletedStagesInStream))
                {
                    <div class="alert alert-warning small">Terrain won't accept a submission for Stage @state.Stage.Stage until Stage @(state.Stage.Stage - 3) is complete. Statements can still be saved.</div>
                }
            }

            @foreach (var group in state.Statements.GroupBy(s => s.Group))
            {
                <h6 class="mt-3">@group.Key</h6>
                <ul class="list-unstyled statement-list">
                    @foreach (var statement in group)
                    {
                        var id = $"st-{statement.InputId}";
                        <li class="@(statement.AlreadyDone ? "done" : "")">
                            <input id="@id" type="checkbox" class="form-check-input"
                                   checked="@(statement.AlreadyDone || ticked.Contains(statement.InputId))"
                                   disabled="@(!CanTick(statement) || working)"
                                   @onchange="e => Toggle(statement, e)" />
                            <label class="form-check-label" for="@id">
                                @statement.Label
                                @if (statement.AlreadyDone && !string.IsNullOrEmpty(statement.VerifiedBy))
                                {
                                    <small class="text-muted"> - verified by @statement.VerifiedBy @statement.VerifiedDate</small>
                                }
                                else if (ticked.Contains(statement.InputId))
                                {
                                    <small class="text-primary"> - to save</small>
                                }
                            </label>
                        </li>
                    }
                </ul>
            }

            @if (CanEdit)
            {
                <div class="row g-2 mt-2">
                    <div class="col-sm-5">
                        <label class="form-label small" for="verifierName">Verifier name</label>
                        <input id="verifierName" class="form-control form-control-sm" @bind="verifier.Name" disabled="@working" />
                    </div>
                    <div class="col-sm-5">
                        <label class="form-label small" for="verifierContact">Verifier email or phone</label>
                        <input id="verifierContact" class="form-control form-control-sm" @bind="verifier.Contact" disabled="@working" />
                    </div>
                </div>
                <div class="small text-muted mt-1">Recorded in Terrain as verified by a Scout member, dated today.</div>

                <div class="mt-3 button-row">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="TickAllRemaining" disabled="@working">Tick all remaining</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="StartSave" disabled="@(working || !ticked.Any())">Save @ticked.Count to Terrain</button>
                    <button type="button" class="btn btn-sm btn-success" @onclick="StartSubmit" disabled="@(working || !ReadyToSubmit)">Submit for review</button>
                    @if (!ReadyToSubmit && !ticked.Any())
                    {
                        <span class="small text-muted">Submitting needs every statement, including the logbook, saved first.</span>
                    }
                </div>

                @if (confirmingSave)
                {
                    <div class="confirm-box mt-3">
                        <strong>Save to Terrain as @member.first_name?</strong>
                        <p class="small mb-2">Beacon will switch to @member.first_name's profile, add these @NewlyTicked().Count statement@(NewlyTicked().Count == 1 ? "" : "s") to @StageTitle, then switch back. Nothing already recorded is changed.</p>
                        <ul class="small">
                            @foreach (var statement in NewlyTicked())
                            {
                                <li>@statement.Label</li>
                            }
                        </ul>
                        @if (NewlyTicked().Any(s => !s.IsLogbook))
                        {
                            <p class="small">Verified by @verifier.Name (@verifier.Contact) on @DateTime.Today.ToString("dd/MM/yyyy").</p>
                        }
                        <button type="button" class="btn btn-sm btn-primary" @onclick="ConfirmSave" disabled="@working">@(working ? "Saving..." : "Yes, save")</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmingSave = false" disabled="@working">Cancel</button>
                    </div>
                }

                @if (confirmingSubmit)
                {
                    <div class="confirm-box mt-3">
                        <strong>Submit @StageTitle for review?</strong>
                        <p class="small mb-2">Beacon will submit it on @member.first_name's behalf. It then goes to the Unit Council to approve in Terrain, and can't be changed here while it's waiting.</p>
                        <button type="button" class="btn btn-sm btn-success" @onclick="ConfirmSubmit" disabled="@working">@(working ? "Submitting..." : "Yes, submit")</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmingSubmit = false" disabled="@working">Cancel</button>
                    </div>
                }
            }
        </div>
    </div>
}
