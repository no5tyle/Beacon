@page "/progress/progress"
@inherits Controller.ProgressController

<PageTitle>Beacon / Progress</PageTitle>

<EditForm Model="@model">

    <div class="mt-3 mb-3 row">
        <h2>Progress @model.GroupName</h2>
    </div>

    @if (string.IsNullOrEmpty(model.UnitId))
    {
        <ChooseUnit />
    }

    @if (loadingMembers)
    {
        <p class="text-muted">Loading youth...</p>
    }
    else if (model.Members != null && model.Members.Any())
    {
        <div class="stack-list">
            <div class="row header">
                <div class="col-sm">
                    <strong>First Name</strong>
                </div>
                <div class="col-sm">
                    <strong>Last Name</strong>
                </div>
                <div class="col-sm">
                    <strong>Member Number</strong>
                </div>
                <div class="col-sm">
                    <strong>Patrol</strong>
                </div>
                <div class="col-sm">
                    <strong>Role</strong>
                </div>
                <div class="col-sm">
                    <strong>Unit Council</strong>
                </div>
                <div class="col-sm-auto row-chevron invisible" aria-hidden="true">&rsaquo;</div>
            </div>

            @foreach (var item in model?.Members)
            {
                @* The whole row opens the youth's progress *@
                <a class="row striped row-link" href="progress/details/@item.id">
                    <div class="col-12 d-sm-none stack-title">@item.first_name @item.last_name</div>
                    <div class="col-sm d-none d-sm-block">
                        @item.first_name
                    </div>
                    <div class="col-sm d-none d-sm-block">
                        @item.last_name
                    </div>
                    <div class="col-sm" data-label="Member Number">@item.member_number</div>
                    <div class="col-sm" data-label="Patrol">@item.patrol_name</div>
                    <div class="col-sm" data-label="Role">@item.patrol_duty</div>
                    <div class="col-sm align-content-center" data-label="Unit Council">@(item.unit_council ? "Yes" : "")</div>
                    <div class="col-sm-auto row-chevron" aria-hidden="true">&rsaquo;</div>
                </a>
            }
        </div>

        <div class="mt-3 mb-3 row">
            <div class="col-sm">
            </div>
        </div>
        <div class="mt-3 mb-3 row">
            <div class="col-sm">
            </div>
        </div>
        <div class="mt-3 mb-3 row">
            <div class="col-sm">
            </div>
        </div>
    }

</EditForm>

