@page "/login"
@inherits Controller.LoginController

<PageTitle>Beacon / Login</PageTitle>

<EditForm Model="@model">

    <div class="mt-3 mb-3 row">
        <h2 class="mb-1">Log in to Beacon</h2>
        <p class="text-muted mb-0">Lighting the way through the Terrain. Use your Scouts Australia member number and Terrain password.</p>
    </div>

    <InstallHint />

    <div class="form-group mb-3 row">
        <label for="branch" class="col-sm-2 col-form-label">
            Branch
        </label>
        <div class="col-sm-3">
            <InputSelect id="branch" class="form-select" @bind-Value="model.Branch">
                <option value="">Select branch</option>
                @foreach (var branch in model.Branches)
                {
                    <option value="@branch.Value">@branch.Key</option>
                }
            </InputSelect>
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    <div class="form-group mb-3 row">
        <label for="memberNumber" class="col-sm-2 col-form-label">
            Member Number
        </label>
        <div class="col-sm-3">
            <InputText id="memberNumber" class="form-control" placeholder="Member Number"
                       autocomplete="username" inputmode="numeric"
                       @bind-Value="model.MemberNumber" />
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    <div class="form-group mb-3 row">
        <label for="password" class="col-sm-2 col-form-label">
            Password
        </label>
        <div class="col-sm-3">
            <input id="password" class="form-control" type="password" placeholder="Password"
                        autocomplete="current-password"
                        @bind="model.Password" />
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-3">
            <label class="col-form-label validation-message">@model.LoginErrorMessage</label>
        </div>
        <div class="col-sm-7">
        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-3">
            <button id="logIn" @onclick="LogInClick" class="btn btn-primary" disabled="@loggingIn">@(loggingIn ? "Logging in..." : "Log In")</button>
        </div>
        <div class="col-sm-7">
        </div>
    </div>
    

</EditForm>